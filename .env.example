# Required
ADMIN_PASSWORD=                     # compared as plaintext, or use ADMIN_PASSWORD_HASH (bcrypt)
# ADMIN_PASSWORD_HASH=              # bcrypt hash: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)" (run in the repo after npm install; in files read by docker compose write each $ as $$)
JWT_SECRET=                         # Random 32+ char string

# Traefik deployment domain (used in docker-compose.traefik.yml)
DOMAIN=monitor.yourdomain.com

# Default OpenClaw gateway for the direct-proxy routes (used when no agent is selected)
NEXT_PUBLIC_DEFAULT_GATEWAY_URL=http://localhost:9500
DEFAULT_GATEWAY_TOKEN=              # OpenClaw API token

# SSRF allowlist for per-instance gateway overrides (x-gateway-url header).
# Comma-separated hostnames that may be targeted in addition to the default
# above, each optionally with a port (host:port; IPv6 as [addr]:port). Overrides
# must be https, may not point at private/loopback IPs, and may not resolve to
# one. An entry without a port allows port 443 only; an entry with a port
# allows only that port (list a host twice for two ports).
# Leave empty to forbid all overrides (only the default gateway is reachable).
ALLOWED_GATEWAY_HOSTS=

# Server-local OpenClaw workspace: Memory Viewer fallback (MEMORY.md, CURRENT.md, memory/*.md)
# and Alert History source (memory/smart-alert-state.json)
CLAWD_DIR=/root/.openclaw/workspace

# Agent tokens (comma-separated, for backward compat — prefer Settings UI)
AGENT_TOKENS=

# Offline agent TTL (ms, default: 300000 = 5min)
AGENT_TTL_MS=300000

# Persistent data directory (tokens, password — mount as volume)
CLAWD_MONITOR_DATA_DIR=/data

# GitHub token for the GitHub PRs widget (read-only; repo/PR and checks read scope)
GITHUB_TOKEN=
# Repositories the GitHub PRs widget lists (comma-separated owner/repo)
GITHUB_REPOS=

# Service Health widget targets (comma-separated `[name=]url`, e.g. api=https://api.example.com/health)
SERVICE_HEALTH_URLS=
